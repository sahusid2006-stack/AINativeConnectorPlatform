{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "input_schema",
        "output_schema",
        "classification",
        "required_privileges",
        "source_evidence",
        "protocol_mapping",
        "pagination",
        "timeout_seconds",
        "retry_policy",
        "test_references"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input_schema": {
          "type": "object"
        },
        "output_schema": {
          "type": "object"
        },
        "classification": {
          "enum": [
            "read",
            "write"
          ]
        },
        "required_privileges": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "excerpt"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "format": "uuid"
              },
              "excerpt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "protocol_mapping": {
          "enum": [
            "rest",
            "database",
            "soap",
            "mcp"
          ]
        },
        "pagination": {
          "type": [
            "object",
            "null"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "retry_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_attempts",
            "safe"
          ],
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "safe": {
              "type": "boolean"
            }
          }
        },
        "test_references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "MappingPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "mappings",
        "generated_tests",
        "dependency_lock",
        "source_snapshot_ids"
      ],
      "properties": {
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operations"
          ],
          "properties": {
            "operations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/Operation"
              }
            }
          }
        },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "driver",
              "request",
              "output_map"
            ],
            "properties": {
              "operation": {
                "type": "string",
                "minLength": 1
              },
              "driver": {
                "enum": [
                  "rest",
                  "database",
                  "soap",
                  "mcp"
                ]
              },
              "request": {
                "type": "object"
              },
              "output_map": {
                "type": "object"
              }
            }
          }
        },
        "generated_tests": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "dependency_lock": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "source_snapshot_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "InvocationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "operation",
        "public_major",
        "arguments"
      ],
      "properties": {
        "connection_id": {
          "type": "string",
          "format": "uuid"
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "public_major": {
          "type": "integer",
          "minimum": 1
        },
        "version_id": {
          "type": "string",
          "format": "uuid"
        },
        "selection": {
          "const": "active"
        },
        "arguments": {
          "type": "object"
        },
        "approval_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "oneOf": [
        {
          "required": [
            "version_id"
          ],
          "not": {
            "required": [
              "selection"
            ]
          }
        },
        {
          "required": [
            "selection"
          ],
          "not": {
            "required": [
              "version_id"
            ]
          }
        }
      ]
    },
    "InvocationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "version_id",
        "status",
        "attempts"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "format": "uuid"
        },
        "version_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "approval_required",
            "outcome_unknown"
          ]
        },
        "output": {},
        "error": {
          "type": "object",
          "required": [
            "category"
          ],
          "properties": {
            "category": {
              "enum": [
                "validation",
                "authentication",
                "permission",
                "not_found",
                "rate_limit",
                "upstream",
                "timeout",
                "outcome_unknown",
                "unsupported_capability"
              ]
            }
          }
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    }
  }
}
