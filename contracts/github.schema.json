{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "title",
        "body",
        "state",
        "html_url"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "open",
            "closed"
          ]
        },
        "html_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "ListInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "repo"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "per_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 30
        }
      }
    },
    "ListOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issues",
        "next_page"
      ],
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        },
        "next_page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "GetInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "repo",
        "issue_number"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "CreateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "repo",
        "title"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "body": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 65536
        }
      }
    }
  }
}
